# Copy to .env (never committed), chmod 600, fill in. The Makefile reads .env.

# make fixtures-verify: the manual-sync materials and the fixtures built from them.
ANONYMIZE_IN=
ANONYMIZE_OUT=

# Yandex Disk: login, app password (https://id.yandex.ru/security/app-passwords),
# photo roots on the Disk separated by "|" (for example: Photos|Camera Uploads),
# OAuth client ID.
YANDEX_LOGIN=
YANDEX_PASSWORD=
YANDEX_ROOTS=
YANDEX_CLIENT_ID=
