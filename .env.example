# Copy to .env (never committed), chmod 600, fill in. Read by make: no quotes.

# make fixtures-verify: absolute paths to the manual-sync materials and to the
# salt the fixtures were built with (default ~/.config/photosync-dev/anonymize.key).
ANONYMIZE_IN=
ANONYMIZE_SALT=

# Yandex Disk folders with photos, separated by "|" (for example: Photos|Camera Uploads).
YANDEX_ROOTS=

# Yandex Disk REST API: an OAuth app from https://oauth.yandex.ru/client/new
# with cloud_api:disk.read and cloud_api:disk.write.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Yandex Disk over WebDAV (spikes only): login and app password
# (https://id.yandex.ru/security/app-passwords).
YANDEX_LOGIN=
YANDEX_PASSWORD=
