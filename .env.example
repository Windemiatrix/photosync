# Copy to .env (never committed) and fill in. The Makefile reads .env.

# make fixtures-verify: the manual-sync materials and the fixtures built from them.
ANONYMIZE_IN=
ANONYMIZE_OUT=

# Yandex Disk spikes. The app password stays in the macOS Keychain:
#   security add-generic-password -s photosync-spike-webdav -a "<login>" -w
YANDEX_LOGIN=
# Photo roots on the Disk, separated by "|", for example: Photos|Camera Uploads
YANDEX_ROOTS=
YANDEX_CLIENT_ID=
